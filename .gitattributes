* text=auto

# Windows 启动脚本必须是 CRLF，cmd.exe / wscript 对 LF 批处理会偶发解析错误
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# 跨平台源码与文档
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.service text eol=lf

# 二进制依赖（离线安装用 wheel）
*.whl binary
*.exe binary
*.png binary
*.jpg binary
*.ico binary
