root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows 脚本必须 CRLF（cmd.exe / wscript 对 LF 会偶发解析错误）
[*.{cmd,bat,ps1,vbs}]
end_of_line = crlf
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
