  },
  "reply": {
    "thinking_text": "已收到，正在处理…",
    "max_chunk": 1800,
    "timeout_ms": 900000,
    "new_chat_words": [
      "/new",
      "新对话",
      "重新开始",
      "清空上下文"
    ],
    "status_words": [
      "/status",
      "/状态"
    ],
    "help_words": [
      "/help",
      "/帮助",
      "/?"
    ],
    "stop_words": [
      "/stop",
      "/停止",
      "停止任务",
      "取消任务"
    ]
  }
